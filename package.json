{
  "name": "stitch-riskvision-ai-intelligence-platform",
  "version": "1.0.0",
  "description": "RiskVision AI Intelligence Platform development server",
  "type": "module",
  "scripts": {
    "dev": "node dev-runner.js",
    "dev:frontend": "vite stitch_riskvision_ai_intelligence_platform/dashboard",
    "build": "vite build stitch_riskvision_ai_intelligence_platform/dashboard",
    "preview": "vite preview stitch_riskvision_ai_intelligence_platform/dashboard",
    "build:dashboard": "npm run build --prefix stitch_riskvision_ai_intelligence_platform/dashboard",
    "backend": ".\\stitch_riskvision_ai_intelligence_platform\\riskvision_ai_backend\\.venv\\Scripts\\python.exe stitch_riskvision_ai_intelligence_platform/riskvision_ai_backend/main.py server",
    "springboot": "mvn spring-boot:run -f stitch_riskvision_ai_intelligence_platform/riskvision_ai_springboot_backend/pom.xml"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
