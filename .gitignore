# ============================================================
#  RiskVision AI Intelligence Platform — .gitignore
# ============================================================

# ── Node / Javascript ────────────────────────────────────────
node_modules/
dist/
build/
out/
.cache/

# ── Java / Spring Boot / Maven ──────────────────────────────
**/target/
*.class
*.jar
*.war
*.ear
maven-bin/
maven.zip

# ── Python / Virtual Env ────────────────────────────────────
**/__pycache__/
**/*.py[cod]
.venv/
venv/
env/
ENV/

# ── Databases & Data Files ───────────────────────────────────
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.csv
**/*.parquet
**/*.pkl
**/*.pickle
**/*.joblib
!**/*.joblib
!**/models/*.joblib
!**/transformers/*.joblib

# ── Secrets & Environment ────────────────────────────────────
.env
.env.*
*.env
!.env.example

# ── IDEs & Editors ───────────────────────────────────────────
.vscode/
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo

# ── System Files ─────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.log
logs/

# ── Temporary Generated Test Reports ─────────────────────────
audit_downloaded_report.pdf
downloaded_test_report.pdf
downloaded_test_report.xlsx
*_test_report.pdf
*_test_report.xlsx
