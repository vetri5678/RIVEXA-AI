# RiskVision AI / RIVEXA — Environment Configuration Template
# Copy this file to .env and customize for your deployment environment

# ─── Active Profile & Domain ──────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=production
ENVIRONMENT=production
FRONTEND_URL=https://rivexa.ai
CORS_ALLOWED_ORIGINS=https://rivexa.ai,https://www.rivexa.ai,https://dashboard.rivexa.ai
SESSION_COOKIE_SECURE=true

# ─── Internal Docker Service Networking ───────────────────────────────────────
ML_SERVICE_URL=http://api:8000
LLM_SERVICE_URL=http://llm-service:5001
BACKEND_URL=http://springboot-backend:8080/api/v1
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
DATABASE_URL=postgresql://[SUPABASE_DB_USER]:[SUPABASE_DB_PASSWORD]@[SUPABASE_DB_HOST]:5432/[SUPABASE_DB_NAME]?sslmode=require
SUPABASE_URL=https://[SUPABASE_PROJECT_ID].supabase.co
SUPABASE_DB_HOST=[SUPABASE_DB_HOST]
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=[SUPABASE_DB_USER]
SUPABASE_DB_PASSWORD=[SUPABASE_DB_PASSWORD]

# ─── JWT Security ─────────────────────────────────────────────────────────────
# MUST be replaced with a strong random secret in production (openssl rand -hex 64)
SECRET_KEY=CHANGE_ME_TO_A_SECURE_64_CHAR_RANDOM_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Admin Bootstrap Credentials ─────────────────────────────────────────────
ADMIN_EMAIL=admin@rivexa.ai
ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN
ADMIN_USERNAME=riskvision_admin

# ─── OAuth 2.0 Credentials ────────────────────────────────────────────────────
# Obtain from Google Cloud Console & GitHub Developer Settings
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=CHANGE_ME_GITHUB_CLIENT_SECRET

# ─── GitHub Personal Access Token (PAT) ────────────────────────────────────────
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_PAT=your-github-personal-access-token

# ─── LLM & External Webhooks ──────────────────────────────────────────────────
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
N8N_WEBHOOK_SECRET=rv_n8n_secret_key_2026
