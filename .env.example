# RiskVision AI — Environment Configuration
# Copy this to .env and customize for your deployment

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
DATABASE_URL=postgresql://[SUPABASE_DB_USER]:[SUPABASE_DB_PASSWORD]@[SUPABASE_DB_HOST]:[SUPABASE_DB_PORT]/[SUPABASE_DB_NAME]?sslmode=require
SUPABASE_URL=https://[SUPABASE_PROJECT_ID].supabase.co
SUPABASE_DB_HOST=[SUPABASE_DB_HOST]
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=[SUPABASE_DB_USER]
SUPABASE_DB_PASSWORD=[SUPABASE_DB_PASSWORD]
SUPABASE_ANON_KEY=[SUPABASE_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[SUPABASE_SERVICE_ROLE_KEY]

# ─── JWT Security ─────────────────────────────────────────────────────────────
# IMPORTANT: Replace with a strong random secret in production
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-me-to-a-secure-64-char-random-string-before-going-live
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Admin Bootstrap Credentials ─────────────────────────────────────────────
# These are used on first startup to create the default super admin account
ADMIN_EMAIL=admin@riskvision.ai
ADMIN_PASSWORD=Admin@RiskVision!2025
ADMIN_USERNAME=riskvision_admin
ADMIN_FULL_NAME=System Administrator

# ─── PostgreSQL (Docker Compose) ─────────────────────────────────────────────
POSTGRES_DB=riskvision
POSTGRES_USER=riskvision
POSTGRES_PASSWORD=riskvision_secret

# ─── Application Settings ─────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
DB_ECHO=false
API_PORT=8000

# ─── CORS (comma-separated allowed origins) ────────────────────────────────────
# ALLOWED_ORIGINS=http://localhost:3000,https://riskvision.yourdomain.com

# ─── Mail Settings ─────────────────────────────────────────────────────────────
# Email Address for Outbound Notification Dispatch
MAIL_USERNAME="admin@riskvision.ai"
# SMTP App Password
MAIL_PASSWORD="your-smtp-app-password"

# ─── Google OAuth 2.0 Credentials ──────────────────────────────────────────────
# Obtain from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Authorized Redirect URI: http://localhost:8080/login/oauth2/code/google
# Authorized Origins: http://localhost:8080, http://localhost:5173
GOOGLE_CLIENT_ID="your-actual-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-actual-google-client-secret"
GITHUB_CLIENT_ID="your-actual-github-client-id"
GITHUB_CLIENT_SECRET="your-actual-github-client-secret"

# ─── GitHub Personal Access Token (PAT) ────────────────────────────────────────
# Required for live GitHub REST API telemetry, repository metadata, security alerts, and higher rate limits.
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user, security_events
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_PAT=your-github-personal-access-token



