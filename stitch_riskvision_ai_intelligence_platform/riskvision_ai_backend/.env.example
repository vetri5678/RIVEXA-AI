# ==============================================================================
#  RiskVision AI — FastAPI Backend Environment Variables
#  File: riskvision_ai_backend/.env.example
#
#  USAGE:
#    1. Copy this file to .env in the same directory
#    2. Fill in EVERY value marked as REQUIRED
#    3. NEVER commit the filled .env file to source control
#
#  To generate a secure JWT secret:
#    python -c "import secrets; print(secrets.token_hex(64))"
# ==============================================================================

# ── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=False
PORT=5000

# ── Database / Supabase PostgreSQL (REQUIRED) ──────────────────────────────────
# Full connection string including sslmode=require for Supabase
DATABASE_URL=postgresql://postgres.your-project-ref:your_password@your-project.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=False

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_DB_HOST=your-project.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your_database_password
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Security (REQUIRED) ────────────────────────────────────────────────────────
# MUST match SECRET_KEY in riskvision_ai_springboot_backend/.env
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=your_64_char_hex_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# REQUIRED: Same value as SECRET_KEY in Spring Boot backend
SPRINGBOOT_JWT_SECRET=your_64_char_hex_secret_here

# ── CORS (comma-separated allowed origins — no wildcard) ───────────────────────
CORS_ORIGINS=["http://localhost:5176","http://127.0.0.1:5176","http://localhost:8080"]

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Email / SMTP (optional — for verification / password reset) ────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
# EMAIL_FROM=noreply@riskvision.ai
FRONTEND_URL=http://localhost:5176

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_ROTATION_DAYS=1
LOG_RETENTION_DAYS=30

# ── ML Model Retraining ────────────────────────────────────────────────────────
RETRAINING_SCHEDULE_CRON=0 2 * * 0
AUTO_RETRAINING_ENABLED=False

# ── Admin Bootstrap (first-run only) ──────────────────────────────────────────
# REQUIRED: Change this before deploying to production
BOOTSTRAP_ADMIN_EMAIL=admin@riskvision.ai
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe@FirstLogin!

# ── Centralized Network Settings ──────────────────────────────────────────────
BACKEND_URL=http://localhost:8080/api/v1
LLM_URL=http://localhost:5001/api/v1

# ── GitHub Personal Access Token (for repository analysis) ────────────────────
# https://github.com/settings/tokens
# Scopes required: repo, read:user
GITHUB_PAT=github_pat_your_token_here
