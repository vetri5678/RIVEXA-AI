# ==============================================================================
#  RiskVision AI — Spring Boot Backend Environment Variables
#  File: riskvision_ai_springboot_backend/.env.example
#
#  USAGE:
#    1. Copy this file to .env in the same directory
#    2. Fill in EVERY value marked as REQUIRED
#    3. NEVER commit the filled .env file to source control
#
#  To generate a secure JWT secret:
#    openssl rand -hex 64
# ==============================================================================

# ── Application ────────────────────────────────────────────────────────────────
PORT=8080
# IMPORTANT: Set this to the URL where the frontend Vite dev server runs.
# In local development, the Vite dev server typically runs on port 5176.
# The backend OAuth success handler uses this URL to redirect after GitHub login.
FRONTEND_URL=http://localhost:5176

# ── JWT Configuration (REQUIRED) ───────────────────────────────────────────────
# MUST be 64+ hex characters. Generate with: openssl rand -hex 64
# This SAME value must be set in riskvision_ai_backend/.env as SECRET_KEY
SECRET_KEY=your_64_char_hex_secret_here

JWT_EXPIRE_LENGTH=1800000
JWT_REFRESH_EXPIRE_LENGTH=604800000

# ── Database / Supabase PostgreSQL (REQUIRED) ──────────────────────────────────
SUPABASE_DB_HOST=your-project.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your_database_password

# ── Google OAuth2 (REQUIRED for Google Login) ─────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── GitHub OAuth2 (REQUIRED for GitHub Login) ─────────────────────────────────
# https://github.com/settings/developers
# Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ── GitHub Personal Access Token (for repository analysis) ────────────────────
# https://github.com/settings/tokens
# Scopes required: repo, read:user
GITHUB_PAT=github_pat_your_token_here

# ── Email / Gmail SMTP (REQUIRED for email verification and password reset) ────
MAIL_USERNAME=your_gmail_address@gmail.com
# Use a Gmail App Password (not your regular password)
# https://myaccount.google.com/apppasswords
MAIL_PASSWORD=your_gmail_app_password

# ── OpenRouter AI API (REQUIRED for AI analysis features) ─────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Admin Bootstrap (first-run only) ──────────────────────────────────────────
# The email for the automatically created first admin account
ADMIN_EMAIL=admin@riskvision.ai
# REQUIRED: Set a strong admin password. Change immediately after first login.
ADMIN_PASSWORD=ChangeMe@FirstLogin!

# ── n8n Workflow Automation (optional) ────────────────────────────────────────
# N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# ── CORS (comma-separated, no wildcard) ───────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:5176

# ── Authentication Policies ────────────────────────────────────────────────────
APP_AUTH_MAX_FAILED_ATTEMPTS=5
APP_AUTH_LOCK_DURATION_MINUTES=15
APP_AUTH_VERIFICATION_TOKEN_HOURS=24
APP_AUTH_RESET_TOKEN_MINUTES=15

# ── File Upload ────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=50MB
FILE_ALLOWED_EXTENSIONS=pdf,csv,xlsx,xls,json,txt,png,jpg,jpeg

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60

# ── ML / LLM Service URLs ─────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=your_internal_ml_api_key
LLM_SERVICE_URL=http://localhost:5001

# ── Session Cookie Security ────────────────────────────────────────────────────
# Set to true in production (requires HTTPS)
SESSION_COOKIE_SECURE=false
